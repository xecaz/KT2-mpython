from machine import Pin, PWM
import time

BUZ_PIN = 38

N = {
    "C4": 262, "CS4": 277, "D4": 294, "DS4": 311, "E4": 330, "F4": 349,
    "FS4": 370, "G4": 392, "GS4": 415, "A4": 440, "AS4": 466, "B4": 494,

    "C5": 523, "CS5": 554, "D5": 587, "DS5": 622, "E5": 659, "F5": 698,
    "FS5": 740, "G5": 784, "GS5": 831, "A5": 880, "AS5": 932, "B5": 988,

    "C6": 1047, "CS6": 1109, "D6": 1175, "DS6": 1245, "E6": 1319,
}

# 0 = rest
R = 0


melody = [
    ("CS5",1), ("DS5",1), ("F5",2),
    ("CS5",1), ("DS5",1), ("F5",2),
    ("F5",1), ("GS5",1), ("AS5",2),
    ("GS5",1), ("F5",1), ("DS5",2),

    ("CS5",1), ("DS5",1), ("F5",2),
    ("GS5",1), ("AS5",1), ("C6",2),
    ("AS5",2), ("GS5",2),

    ("CS5",1), ("DS5",1), ("F5",2),
    ("CS5",1), ("DS5",1), ("F5",2),
    ("F5",1), ("GS5",1), ("AS5",2),
    ("GS5",1), ("F5",1), ("DS5",2),

    ("CS5",1), ("DS5",1), ("F5",2),
    ("GS5",1), ("AS5",1), ("C6",2),
    ("AS5",2), ("GS5",2),

    ("C6",2), ("AS5",1), ("GS5",1),
    ("F5",2),
    ("C6",2), ("AS5",1), ("GS5",1),
    ("F5",2),

    ("AS5",2), ("GS5",2),
    ("F5",1), ("F5",1), ("GS5",2),
    ("AS5",2), ("C6",3),

    ("C6",2), ("AS5",1), ("GS5",1),
    ("F5",2),
    ("C6",2), ("AS5",1), ("GS5",1),
    ("F5",2),

    ("AS5",2), ("GS5",2),
    ("F5",1), ("F5",1), ("GS5",2),
    ("AS5",2), ("C6",3),

    ("DS6",2), ("C6",2), ("AS5",2),
    ("GS5",4),
]

tempo = 0.42  

def play(note, beats):
    if note == R:
        time.sleep(beats * tempo)
        return
    freq = N[note]
    pwm = PWM(Pin(BUZ_PIN))
    pwm.freq(freq)
    pwm.duty_u16(32000)
    time.sleep(beats * tempo)
    pwm.deinit()


for note, beats in melody:
    play(note, beats)

Pin(BUZ_PIN, Pin.IN)
print("Aidscow.")


